  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  corporateClient CorporateClient @relation(fields: [corporateClientId], references: [id], onDelete: Cascade)

  @@map("corporate_client_notes")
}

model SalesLead {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  corporateClientId String? @db.Uuid

  leadNumber  String
  source      SalesLeadSource @default(OTHER)
  title       String
  description String?         @db.Text

  destination        String?
  estimatedTravelers Int?
  expectedDate       DateTime? @db.Date

  budget      Decimal? @db.Decimal(12, 2)
  probability Int? // 0-100 percentage

  priority          SalesLeadPriority @default(MEDIUM)
  assignedTo        String?           @db.Uuid
  status            SalesLeadStatus   @default(NEW)
  expectedCloseDate DateTime?         @db.Date

  lostReason String?
  notes      String? @db.Text

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  corporateClient CorporateClient?    @relation(fields: [corporateClientId], references: [id])
  activities      SalesActivity[]
  followUps       FollowUp[]
  requests        CustomTourRequest[]
  quotations      Quotation[]

  @@unique([organizationId, leadNumber])
  @@index([organizationId, status])
  @@index([assignedTo])
  @@map("sales_leads")
}

model SalesActivity {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  leadId            String? @db.Uuid
  corporateClientId String? @db.Uuid
  assignedTo        String? @db.Uuid

  type        SalesActivityType
  subject     String
  description String?           @db.Text

  scheduledAt DateTime?
  completedAt DateTime?
  status      String    @default("PENDING") // PENDING, COMPLETED, CANCELLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead            SalesLead?       @relation(fields: [leadId], references: [id])
  corporateClient CorporateClient? @relation(fields: [corporateClientId], references: [id])

  @@index([leadId])
  @@index([corporateClientId])
  @@index([assignedTo])
  @@map("sales_activities")
}

model FollowUp {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  leadId         String @db.Uuid

  title      String
  dueAt      DateTime
  assignedTo String?           @db.Uuid
  priority   SalesLeadPriority @default(MEDIUM)
  status     String            @default("PENDING") // PENDING, COMPLETED, MISSED, CANCELLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         SalesLead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([assignedTo])
  @@index([dueAt])
  @@map("follow_ups")
}

model CustomTourRequest {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  requestNumber     String
  corporateClientId String? @db.Uuid
  leadId            String? @db.Uuid

  destination     String?
  origin          String?
  travelStartDate DateTime? @db.Date
  travelEndDate   DateTime? @db.Date
  duration        Int?

  adultCount     Int @default(0)
  childCount     Int @default(0)
  infantCount    Int @default(0)
  totalTravelers Int @default(0)

  budgetMin Decimal? @db.Decimal(12, 2)
  budgetMax Decimal? @db.Decimal(12, 2)

  transportPreference     String?
  accommodationPreference String?
  mealPreference          String?
  activityPreference      String?
  specialRequirements     String? @db.Text

  // Requirement versioning is stored in JSON
  structuredRequirements Json?

  status     CustomTourStatus @default(REQUESTED)
  assignedTo String?          @db.Uuid
  notes      String?          @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  corporateClient CorporateClient? @relation(fields: [corporateClientId], references: [id])
  lead            SalesLead?       @relation(fields: [leadId], references: [id])
  quotations      Quotation[]

  @@unique([organizationId, requestNumber])
  @@index([organizationId, status])
  @@map("custom_tour_requests")
}

model Quotation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  quotationNumber   String
  version           Int     @default(1)
  parentQuotationId String? @db.Uuid
  changeReason      String? @db.Text

  corporateClientId   String  @db.Uuid
  leadId              String? @db.Uuid
  customTourRequestId String? @db.Uuid

  status     QuotationStatus @default(DRAFT)
  validFrom  DateTime        @default(now())
  validUntil DateTime
  currency   String          @default("BDT") @db.VarChar(3)

  subtotal          Decimal @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal @default(0) @db.Decimal(12, 2)
  feeAmount         Decimal @default(0) @db.Decimal(12, 2)
  totalSellingPrice Decimal @default(0) @db.Decimal(12, 2) // Grand Total to client
  totalCostPrice    Decimal @default(0) @db.Decimal(12, 2) // Internal cost
  grossProfit       Decimal @default(0) @db.Decimal(12, 2)

  paymentTerms      String? @db.Text
  cancellationTerms String? @db.Text
  notes             String? @db.Text
  internalNotes     String? @db.Text

  acceptedAt       DateTime?
  acceptedBy       String?
  acceptanceMethod String?
  acceptanceNote   String?   @db.Text

  rejectedAt   DateTime?
  rejectedBy   String?
  rejectReason String?   @db.Text

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  String?   @db.Uuid
  archivedAt DateTime?

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentQuotation   Quotation?         @relation("QuotationVersions", fields: [parentQuotationId], references: [id])
  childQuotations   Quotation[]        @relation("QuotationVersions")
  corporateClient   CorporateClient    @relation(fields: [corporateClientId], references: [id])
  lead              SalesLead?         @relation(fields: [leadId], references: [id])
  customTourRequest CustomTourRequest? @relation(fields: [customTourRequestId], references: [id])

  items             QuotationItem[]
  paymentMilestones QuotationPaymentMilestone[]
  approvalRequests  ApprovalRequest[]
  proposals         Proposal[]
  contracts         CorporateContract[]
  bookings          Booking[]

  @@unique([organizationId, quotationNumber, version])
  @@index([organizationId, status])
  @@map("quotations")
}

model QuotationItem {
  id          String @id @default(uuid()) @db.Uuid
  quotationId String @db.Uuid

  serviceType String // Transport, Hotel, Guide, etc.
  description String
  quantity    Int
  unit        String?

  unitCostPrice    Decimal @default(0) @db.Decimal(12, 2)
  unitSellingPrice Decimal @default(0) @db.Decimal(12, 2)

  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)

  costTotal    Decimal @default(0) @db.Decimal(12, 2)
  sellingTotal Decimal @default(0) @db.Decimal(12, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

model QuotationPaymentMilestone {
  id          String @id @default(uuid()) @db.Uuid
  quotationId String @db.Uuid

  name       String // e.g. "Advance 30%"
  percentage Decimal?  @db.Decimal(5, 2)
  amount     Decimal   @db.Decimal(12, 2)
  dueDate    DateTime?

  status PaymentMilestoneStatus @default(PENDING)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_payment_milestones")
}

model ApprovalRequest {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  entityType String // QUOTATION, CONTRACT, DISCOUNT
  entityId   String @db.Uuid

  requestedBy String  @db.Uuid
  approverId  String? @db.Uuid

  status  ApprovalStatus @default(PENDING)
  comment String?        @db.Text

  requestedAt    DateTime  @default(now())
  resolvedAt     DateTime?
  resolutionNote String?   @db.Text

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    Quotation?   @relation(fields: [entityId], references: [id], map: "approval_quotation_fkey")

  @@index([organizationId, status])
  @@map("approval_requests")
}

model Proposal {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  proposalNumber String
  quotationId    String @db.Uuid
  version        Int    @default(1)

  status     ProposalStatus @default(DRAFT)
  validUntil DateTime

  title        String
  introduction String? @db.Text
  content      String? @db.Text // Can store complex JSON or HTML for the document
  notes        String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    Quotation           @relation(fields: [quotationId], references: [id])
  contracts    CorporateContract[]

  @@unique([organizationId, proposalNumber, version])
  @@map("proposals")
}

model CorporateContract {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  contractNumber   String
  version          Int     @default(1)
  parentContractId String? @db.Uuid
  changeReason     String? @db.Text

  corporateClientId String  @db.Uuid
  quotationId       String? @db.Uuid
  proposalId        String? @db.Uuid

  title     String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  status        ContractStatus @default(DRAFT)
  contractValue Decimal        @db.Decimal(12, 2)
  currency      String         @default("BDT") @db.VarChar(3)

  paymentTerms      String? @db.Text
  cancellationTerms String? @db.Text
  specialTerms      String? @db.Text

  signedAt    DateTime?
  signedBy    String? // Client signatory name
  documentUrl String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  String?   @db.Uuid
  archivedAt DateTime?

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentContract  CorporateContract?  @relation("ContractVersions", fields: [parentContractId], references: [id])
  childContracts  CorporateContract[] @relation("ContractVersions")
  corporateClient CorporateClient     @relation(fields: [corporateClientId], references: [id])
  quotation       Quotation?          @relation(fields: [quotationId], references: [id])
  proposal        Proposal?           @relation(fields: [proposalId], references: [id])
  bookings        Booking[]

  @@unique([organizationId, contractNumber, version])
  @@index([organizationId, status])
  @@map("corporate_contracts")
}

// ==========================================
// 10. PHASE 09: MARKETING, LOYALTY, REVIEWS
// ==========================================

enum SegmentType {
  MANUAL
  DYNAMIC
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionType {
  TOUR_DISCOUNT
  COUPON
  EARLY_BIRD
  LAST_MINUTE
  SEASONAL
  FLASH_SALE
  BUNDLE
  LOYALTY
  REFERRAL
}

enum CampaignType {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  MULTI_CHANNEL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

enum RecipientStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  FAILED
  SKIPPED
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
  REVERSAL
}

enum ReferralStatus {
  CLICKED
  REGISTERED
  BOOKED
  QUALIFIED
  REWARDED
  CANCELLED
}

enum AutomationStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

// ---- CUSTOMER SEGMENTATION & TAGS ----

model CustomerSegment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  name        String
  code        String
  description String?     @db.Text
  type        SegmentType @default(MANUAL)

  rules    Json? // e.g. { "totalSpent": { "gte": 50000 } }
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      CustomerSegmentMember[]

  @@unique([organizationId, code])
  @@map("customer_segments")
}

model CustomerSegmentMember {
  id         String @id @default(uuid()) @db.Uuid
  segmentId  String @db.Uuid
  customerId String @db.Uuid

  assignedAt DateTime @default(now())
  assignedBy String?  @db.Uuid
  source     String   @default("MANUAL") // MANUAL, RULE_ENGINE, IMPORT

  segment  CustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([segmentId, customerId])
  @@map("customer_segment_members")
}

model CustomerTag {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  name        String
  color       String?
  description String? @db.Text
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  CustomerTagAssignment[]

  @@unique([organizationId, name])
  @@map("customer_tags")
}

model CustomerTagAssignment {
  tagId      String @db.Uuid
  customerId String @db.Uuid

  assignedAt DateTime @default(now())
  assignedBy String?  @db.Uuid

  tag      CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([tagId, customerId])
  @@map("customer_tag_assignments")
}

// ---- COUPONS & PROMOTIONS ----

model Coupon {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  code        String
  name        String
  description String? @db.Text

  discountType  CouponDiscountType
  discountValue Decimal            @db.Decimal(12, 2)
  maxDiscount   Decimal?           @db.Decimal(12, 2)

  minimumOrderValue Decimal? @db.Decimal(12, 2)
  maximumOrderValue Decimal? @db.Decimal(12, 2)

  usageLimit       Int?
  usagePerCustomer Int? @default(1)
  usageCount       Int  @default(0)

  startAt   DateTime?
  endAt     DateTime?
  isActive  Boolean   @default(true)
  stackable Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  redemptions  CouponRedemption[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive, startAt, endAt])
  @@map("coupons")
}

model CouponRedemption {
  id         String @id @default(uuid()) @db.Uuid
  couponId   String @db.Uuid
  customerId String @db.Uuid
  bookingId  String @db.Uuid

  discountAmount Decimal  @db.Decimal(12, 2)
  redeemedAt     DateTime @default(now())

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([couponId, bookingId]) // Prevent multi-use on same booking
  @@map("coupon_redemptions")
}

model Promotion {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  name        String
  slug        String
  title       String
  description String? @db.Text

  promotionType PromotionType

  startAt DateTime?
  endAt   DateTime?
  status  CategoryStatus @default(ACTIVE)

  bannerImage String?
  landingUrl  String?
  priority    Int     @default(0)
  isFeatured  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@map("promotions")
}

// ---- MARKETING CAMPAIGNS & NOTIFICATIONS ----

model MarketingCampaign {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  name        String
  code        String
  description String? @db.Text

  type         CampaignType
  audienceType String // e.g., 'ALL', 'SEGMENT', 'CORPORATE'

  startAt DateTime?
  endAt   DateTime?
  status  CampaignStatus @default(DRAFT)

  budget Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipients   CampaignRecipient[]
  bookings     Booking[]

  @@unique([organizationId, code])
  @@map("marketing_campaigns")
}

model CampaignRecipient {
  id         String @id @default(uuid()) @db.Uuid
  campaignId String @db.Uuid
  customerId String @db.Uuid

  channel String // EMAIL, SMS, etc
  status  RecipientStatus @default(PENDING)

  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?

  failureReason String? @db.Text

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId, channel])
  @@map("campaign_recipients")
}

model MarketingTemplate {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  name    String
  channel String // EMAIL, SMS, PUSH, WHATSAPP
  subject String?
  content String  @db.Text

  variables Json? // array of allowed vars

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name, channel])
  @@map("marketing_templates")
}

// ---- LOYALTY & REFERRALS ----

model LoyaltyAccount {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  customerId     String @unique @db.Uuid

  balance          Decimal @default(0) @db.Decimal(12, 2)
  lifetimeEarned   Decimal @default(0) @db.Decimal(12, 2)
  lifetimeRedeemed Decimal @default(0) @db.Decimal(12, 2)
  status           String  @default("ACTIVE") // ACTIVE, BLOCKED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid

  type   LoyaltyTransactionType
  points Decimal                @db.Decimal(12, 2)

  referenceType String? // e.g. 'BOOKING'
  referenceId   String? @db.Uuid

  description String?
  expiresAt   DateTime?

  createdAt DateTime @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("loyalty_transactions")
}

model ReferralCode {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  customerId     String @unique @db.Uuid

  code   String
  status String @default("ACTIVE")

  usageLimit Int?
  usageCount Int  @default(0)

  startAt DateTime?
  endAt   DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@map("referral_codes")
}

model Referral {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  referrerId String  @db.Uuid
  referredId String  @db.Uuid
  bookingId  String? @db.Uuid

  referralCode String

  status ReferralStatus @default(CLICKED)

  createdAt   DateTime  @default(now())
  qualifiedAt DateTime?
  rewardedAt  DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referrer     Customer     @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referred     Customer     @relation("ReferralsReceived", fields: [referredId], references: [id], onDelete: Cascade)
  booking      Booking?     @relation(fields: [bookingId], references: [id])

  @@unique([referredId]) // A customer can only be referred once
  @@map("referrals")
}

// ---- AUTOMATIONS & REVIEWS ----

model AutomationRule {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  name       String
  trigger    String // e.g., 'NEW_CUSTOMER', 'BOOKING_CREATED'
  conditions Json? // e.g., rules checking properties
  actions    Json // array of actions

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logs         AutomationLog[]

  @@map("automation_rules")
}

model AutomationLog {
  id         String  @id @default(uuid()) @db.Uuid
  ruleId     String  @db.Uuid
  customerId String? @db.Uuid
  eventId    String? // The reference event

  status AutomationStatus @default(QUEUED)

  startedAt     DateTime?
  completedAt   DateTime?
  failureReason String?   @db.Text

  createdAt DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@map("automation_logs")
}

model Review {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  customerId     String  @db.Uuid
  bookingId      String  @db.Uuid
  tourPackageId  String? @db.Uuid // Optional, just for direct aggregations

  rating  Int
  comment String? @db.Text

  status ReviewStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([customerId, bookingId])
  @@map("reviews")
}

// ==========================================
// 11. PHASE 10 PLACEHOLDERS (FINANCE)
// ==========================================

model Vendor {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @db.Uuid
  name              String
  email             String?
  phone             String?
  address           String?             @db.Text
  status            String              @default("ACTIVE")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bills             VendorBill[]
  VehicleFuelRecord VehicleFuelRecord[]
  VehicleRental     VehicleRental[]
  PurchaseOrder     PurchaseOrder[]

  @@index([organizationId])
  @@map("vendors")
}

model Expense {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  amount         Decimal      @db.Decimal(12, 2)
  category       String
  date           DateTime
  description    String?      @db.Text
  status         String       @default("PENDING")
  tourScheduleId String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("expenses")
}

model VendorBill {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  vendorId       String       @db.Uuid
  amount         Decimal      @db.Decimal(12, 2)
  status         String       @default("PENDING")
  date           DateTime
  dueDate        DateTime?
  referenceId    String?      @db.Uuid // E.g., GoodsReceipt ID
  referenceType  String? // E.g., 'GOODS_RECEIPT'
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor         Vendor       @relation(fields: [vendorId], references: [id])

  @@index([organizationId, vendorId])
  @@map("vendor_bills")
}

// ==========================================
// 12. PHASE 11: OPERATIONAL RESOURCE MANAGEMENT
// ==========================================

enum TourReadinessStatus {
  NOT_READY
  PARTIALLY_READY
  READY
  CRITICAL
}

enum StaffShiftStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  CONVERTED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}

enum GoodsReceiptStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  RECEIVE
  ISSUE
  TRANSFER
  RETURN
  ADJUSTMENT
  WASTE
  DAMAGE
}

enum EquipmentStatus {
  GOOD
  MINOR_DAMAGE
  DAMAGED
  LOST
  UNDER_REPAIR
}

// ---- TOUR READINESS & OPERATIONS ----

model ChecklistTemplate {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  title          String
  description    String?           @db.Text
  category       ChecklistCategory
  isActive       Boolean           @default(true)
  sortOrder      Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        ChecklistTemplateItem[]

  @@map("checklist_templates")
}

model ChecklistTemplateItem {
  id                  String  @id @default(uuid()) @db.Uuid
  checklistTemplateId String  @db.Uuid
  title               String
  description         String? @db.Text
  isRequired          Boolean @default(true)
  sortOrder           Int     @default(0)

  template ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id], onDelete: Cascade)

  @@map("checklist_template_items")
}

model TourEmergencyContact {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  tourScheduleId String @db.Uuid

  priority Int     @default(0)
  name     String
  role     String // 'Tour Manager', 'Lead Guide', 'Driver', 'Office'
  phone    String
  email    String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tourSchedule TourSchedule @relation(fields: [tourScheduleId], references: [id], onDelete: Cascade)

  @@index([tourScheduleId])
  @@map("tour_emergency_contacts")
}

// ---- VEHICLES & DRIVERS EXTENSIONS ----

model VehicleDocument {
  id             String    @id @default(uuid()) @db.Uuid
  vehicleId      String    @db.Uuid
  documentType   String // 'Registration', 'Fitness Certificate', 'Insurance', 'Tax Token', 'Route Permit'
  documentNumber String?
  issueDate      DateTime? @db.Date
  expiryDate     DateTime? @db.Date
  fileUrl        String?
  status         String    @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_documents")
}

model VehicleTripLog {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  vehicleId      String  @db.Uuid
  tourScheduleId String? @db.Uuid
  driverId       String? @db.Uuid

  tripStart     DateTime
  tripEnd       DateTime?
  startOdometer Int?
  endOdometer   Int?
  fuelConsumed  Decimal?  @db.Decimal(10, 2)
  route         String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tourSchedule TourSchedule? @relation(fields: [tourScheduleId], references: [id])
  driver       Driver?       @relation(fields: [driverId], references: [id])

  @@index([vehicleId])
  @@map("vehicle_trip_logs")
}

model VehicleFuelRecord {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  vehicleId      String  @db.Uuid
  vendorId       String? @db.Uuid

  date          DateTime
  liters        Decimal  @db.Decimal(10, 2)
  pricePerLiter Decimal  @db.Decimal(10, 2)
  totalCost     Decimal  @db.Decimal(12, 2)
  odometer      Int?
  receiptUrl    String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vendor       Vendor?      @relation(fields: [vendorId], references: [id])

  @@index([vehicleId])
  @@map("vehicle_fuel_records")
}

model VehicleRental {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  vehicleId      String @db.Uuid
  vendorId       String @db.Uuid

  rentalStart DateTime
  rentalEnd   DateTime
  rate        Decimal  @db.Decimal(12, 2)
  deposit     Decimal? @db.Decimal(12, 2)
  terms       String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vendor       Vendor       @relation(fields: [vendorId], references: [id])

  @@map("vehicle_rentals")
}

model DriverDutyLog {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  driverId       String  @db.Uuid
  tourScheduleId String? @db.Uuid

  startTime     DateTime
  endTime       DateTime?
  startOdometer Int?
  endOdometer   Int?
  notes         String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  driver       Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  tourSchedule TourSchedule? @relation(fields: [tourScheduleId], references: [id])

  @@index([driverId])
  @@map("driver_duty_logs")
}

// ---- STAFF SCHEDULING ----

model StaffShift {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  staffId        String  @db.Uuid // Refers to User
  tourScheduleId String? @db.Uuid

  date      DateTime         @db.Date
  startTime DateTime
  endTime   DateTime
  location  String?
  notes     String?          @db.Text
  status    StaffShiftStatus @default(SCHEDULED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        User          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  tourSchedule TourSchedule? @relation(fields: [tourScheduleId], references: [id])

  @@index([staffId])
  @@map("staff_shifts")
}

// ---- PROCUREMENT SYSTEM ----

model PurchaseRequest {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  requestNumber  String
  requestedBy    String                @db.Uuid // Refers to User
  department     String?
  requiredDate   DateTime?             @db.Date
  priority       String                @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  reason         String?               @db.Text
  status         PurchaseRequestStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [requestedBy], references: [id])
  items        PurchaseRequestItem[]

  @@unique([organizationId, requestNumber])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                String  @id @default(uuid()) @db.Uuid
  purchaseRequestId String  @db.Uuid
  tourScheduleId    String? @db.Uuid
  category          String?

  item              String
  description       String?  @db.Text
  quantity          Decimal  @db.Decimal(10, 2)
  estimatedUnitCost Decimal? @db.Decimal(12, 2)
  estimatedTotal    Decimal? @db.Decimal(12, 2)

  request      PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  tourSchedule TourSchedule?   @relation(fields: [tourScheduleId], references: [id])

  @@map("purchase_request_items")
}

model PurchaseOrder {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  poNumber       String
  vendorId       String @db.Uuid

  orderDate    DateTime            @db.Date
  expectedDate DateTime?           @db.Date
  status       PurchaseOrderStatus @default(DRAFT)

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)
  notes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor        Vendor              @relation(fields: [vendorId], references: [id])
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@unique([organizationId, poNumber])
  @@index([organizationId, vendorId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @db.Uuid
  tourScheduleId  String? @db.Uuid
  inventoryItemId String? @db.Uuid

  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  tax         Decimal @default(0) @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  order         PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  tourSchedule  TourSchedule?  @relation(fields: [tourScheduleId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @db.Uuid
  purchaseOrderId String @db.Uuid
  receiptNumber   String

  receivedBy String             @db.Uuid // Refers to User
  receivedAt DateTime           @default(now())
  status     GoodsReceiptStatus @default(DRAFT)
  notes      String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [receivedBy], references: [id])
  items         GoodsReceiptItem[]

  @@unique([organizationId, receiptNumber])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String @id @default(uuid()) @db.Uuid
  goodsReceiptId String @db.Uuid

  description String
  orderedQty  Decimal @db.Decimal(10, 2)
  receivedQty Decimal @default(0) @db.Decimal(10, 2)
  rejectedQty Decimal @default(0) @db.Decimal(10, 2)
  acceptedQty Decimal @default(0) @db.Decimal(10, 2)

  receipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  @@map("goods_receipt_items")
}

// ---- INVENTORY MANAGEMENT ----

model InventoryLocation {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  type           String // 'MAIN_WAREHOUSE', 'OFFICE', 'VEHICLE', 'TOUR_KIT', 'BRANCH'
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stocks        StockLevel[]
  movementsFrom StockMovement[] @relation("FromLocation")
  movementsTo   StockMovement[] @relation("ToLocation")

  @@map("inventory_locations")
}

model InventoryItem {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  itemCode       String
  name           String
  category       String
  unit           String // 'PCS', 'BOX', 'KG', 'LITERS'
  description    String? @db.Text

  minimumStock Decimal  @default(0) @db.Decimal(10, 2)
  maximumStock Decimal? @db.Decimal(10, 2)
  reorderPoint Decimal  @default(0) @db.Decimal(10, 2)
  costMethod   String   @default("AVERAGE_COST") // AVERAGE_COST, FIFO
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stocks       StockLevel[]
  movements    StockMovement[]
  poItems      PurchaseOrderItem[]

  @@unique([organizationId, itemCode])
  @@map("inventory_items")
}

model StockLevel {
  id              String  @id @default(uuid()) @db.Uuid
  inventoryItemId String  @db.Uuid
  locationId      String  @db.Uuid
  quantity        Decimal @default(0) @db.Decimal(10, 2)

  updatedAt DateTime @updatedAt

  item     InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([inventoryItemId, locationId])
  @@map("stock_levels")
}

model StockMovement {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @db.Uuid
  inventoryItemId String @db.Uuid

  fromLocationId String? @db.Uuid
  toLocationId   String? @db.Uuid

  quantity Decimal           @db.Decimal(10, 2)
  type     StockMovementType

  referenceType String? // 'PURCHASE_ORDER', 'TOUR_SCHEDULE', 'ADJUSTMENT'
  referenceId   String? @db.Uuid

  createdBy String   @db.Uuid // Refers to User
  createdAt DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  fromLocation InventoryLocation? @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocation   InventoryLocation? @relation("ToLocation", fields: [toLocationId], references: [id])
  user         User               @relation(fields: [createdBy], references: [id])

  @@index([inventoryItemId])
  @@map("stock_movements")
}

// ---- EQUIPMENT MANAGEMENT ----

model Equipment {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  name           String
  type           String // 'LIFE_JACKET', 'TENT', 'CAMERA', etc.
  status         EquipmentStatus @default(GOOD)
  isActive       Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  EquipmentAssignment[]

  @@map("equipment")
}

model EquipmentAssignment {
  id             String  @id @default(uuid()) @db.Uuid
  equipmentId    String  @db.Uuid
  tourScheduleId String? @db.Uuid
  staffId        String? @db.Uuid
  vehicleId      String? @db.Uuid

  assignedAt DateTime        @default(now())
  returnedAt DateTime?
  condition  EquipmentStatus @default(GOOD)
  notes      String?         @db.Text

  equipment    Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  tourSchedule TourSchedule? @relation(fields: [tourScheduleId], references: [id])
  staff        User?         @relation(fields: [staffId], references: [id])
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id])

  @@index([equipmentId])
  @@map("equipment_assignments")
}
