  legalName   String?
  companyCode String?

  industry    String?
  companyType String?

  website        String?
  email          String?
  phone          String?
  alternatePhone String?

  address String?
  city    String?
  country String?

  contactPersonName        String?
  contactPersonDesignation String?
  contactPersonPhone       String?
  contactPersonEmail       String?

