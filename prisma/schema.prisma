// ==========================================
// 1. GENERATOR & DATASOURCE
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 2. ENUMS
// ==========================================

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum PlatformAdminStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

// ==========================================
// 3. PLATFORM MODELS
// ==========================================

model PlatformAdmin {
  id           String              @id @default(uuid()) @db.Uuid
  name         String
  email        String              @unique
  passwordHash String
  status       PlatformAdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_admins")
}

// ==========================================
// 4. ORGANIZATION MODELS
// ==========================================

model Organization {
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  slug            String             @unique
  legalName       String?
  email           String?
  phone           String?
  website         String?
  logoUrl         String?
  defaultCurrency String             @default("USD") @db.VarChar(3)
  timezone        String             @default("UTC")
  countryCode     String             @default("US") @db.VarChar(2)
  status          OrganizationStatus @default(ACTIVE)

  settings OrganizationSettings?

  sequences Sequence[]
  users     User[]
  roles     Role[]
  auditLogs AuditLog[]

  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  deletedAt               DateTime?
  AuthSession             AuthSession[]
  OrganizationInvitation  OrganizationInvitation[]
  Destination             Destination[]
  TourCategory            TourCategory[]
  PickupPoint             PickupPoint[]
  TourPackage             TourPackage[]
  TourSchedule            TourSchedule[]
  Customer                Customer[]
  Traveler                Traveler[]
  Booking                 Booking[]
  SeatReservation         SeatReservation[]
  BookingStatusHistory    BookingStatusHistory[]
  BookingNote             BookingNote[]
  IdempotencyRecord       IdempotencyRecord[]
  TourOperation           TourOperation[]
  OperationalChecklist    OperationalChecklist[]
  ManifestVersion         ManifestVersion[]
  Vehicle                 Vehicle[]
  VehicleMaintenance      VehicleMaintenance[]
  Driver                  Driver[]
  TourTransportAssignment TourTransportAssignment[]
  Hotel                   Hotel[]
  HotelRoomType           HotelRoomType[]
  TourHotelAssignment     TourHotelAssignment[]
  RoomAllocation          RoomAllocation[]
  TourGuide               TourGuide[]
  TourGuideAssignment     TourGuideAssignment[]
  TourIncident            TourIncident[]
  TourOperationNote       TourOperationNote[]
  CorporateClient         CorporateClient[]
  SalesLead               SalesLead[]
  SalesActivity           SalesActivity[]
  FollowUp                FollowUp[]
  CustomTourRequest       CustomTourRequest[]
  Quotation               Quotation[]
  ApprovalRequest         ApprovalRequest[]
  Proposal                Proposal[]
  CorporateContract       CorporateContract[]

  @@index([slug])
  @@index([deletedAt])
  @@map("organizations")
}

model OrganizationSettings {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @db.Uuid

  dateFormat                 String  @default("YYYY-MM-DD")
  timeFormat                 String  @default("24h")
  weekStartsOn               Int     @default(1) // 0 = Sunday, 1 = Monday
  language                   String  @default("en")
  bookingPrefix              String  @default("BKG")
  invoicePrefix              String  @default("INV")
  quotationPrefix            String  @default("QUO")
  customerPrefix             String  @default("CUS")
  defaultBookingStatus       String  @default("PENDING")
  allowOnlineBooking         Boolean @default(false)
  showPublicSeatAvailability Boolean @default(false)
  lowSeatThreshold           Int     @default(5)
  defaultCancellationPolicy  String? @db.Text

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organization_settings")
}

model Sequence {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  key          String // e.g., 'BOOKING', 'INVOICE'
  prefix       String
  currentValue Int    @default(0)
  padding      Int    @default(5)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("sequences")
}

// ==========================================
// 5. USER & RBAC MODELS
// ==========================================

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  organizationId      String     @db.Uuid
  name                String
  email               String
  phone               String?
  passwordHash        String
  avatarUrl           String?
  status              UserStatus @default(INVITED)
  passwordChangedAt   DateTime?
  emailVerifiedAt     DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  lastLoginUserAgent  String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles    UserRole[]
  authSessions AuthSession[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
  @@map("users")
}

model Role {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  slug           String
  description    String?
  isSystem       Boolean @default(false)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  userRoles    UserRole[]

  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  OrganizationInvitation OrganizationInvitation[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique // e.g. 'booking.create'
  name        String
  description String?
  module      String // e.g. 'booking', 'finance'

  roles RolePermission[]

  createdAt DateTime @default(now())

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ==========================================
// 6. AUDIT MODELS
// ==========================================

model AuditLog {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @db.Uuid // null for platform events
  userId         String? @db.Uuid

  action     String // e.g., 'CREATE', 'UPDATE', 'DELETE'
  module     String // e.g., 'tours', 'bookings'
  entityType String // e.g., 'Booking', 'Tour'
  entityId   String // UUID of the entity

  oldValues Json? // State before action
  newValues Json? // State after action
  metadata  Json? // Additional context (e.g., reason)

  ipAddress String?
  userAgent String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  // We do not strict-relate to User to preserve audit log if user is deleted,
  // or we can use SetNull. We'll leave it as a string mapping without foreign key
  // to guarantee audit logs never disappear when a user is hard-deleted.
  // Actually, SetNull on relation is fine if we make it a relation.
  // But standard practice for immutable logs is to just store the ID or rely on SetNull.
  // We'll store userId but no foreign key to avoid cascading complexities, 
  // or we can use a relation with onDelete: SetNull. Let's use standard string field for safety.

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ==========================================
// 7. AUTH & SECURITY MODELS
// ==========================================

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  organizationId   String    @db.Uuid
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?
  deviceName       String?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model OrganizationInvitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  email          String
  roleIds        String[]  @db.Uuid
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  cancelledAt    DateTime?
  invitedBy      String    @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  role      Role?    @relation(fields: [roleId], references: [id])
  roleId    String?  @db.Uuid

  @@index([organizationId])
  @@index([email])
  @@map("organization_invitations")
}

// ==========================================
// 8. TOUR ENUMS
// ==========================================

enum DestinationStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PickupPointStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TourPackageStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum TourScheduleStatus {
  DRAFT
  OPEN
  FULL
  CLOSED
  CANCELLED
  COMPLETED
}

enum TourAddonStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

// ==========================================
// 9. DESTINATION & CATEGORY MODELS
// ==========================================

model Destination {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @db.Uuid
  name             String
  slug             String
  shortDescription String?
  description      String?
  country          String?
  division         String?
  district         String?
  locationName     String?
  latitude         Decimal?          @db.Decimal(10, 8)
  longitude        Decimal?          @db.Decimal(11, 8)
  coverImageUrl    String?
  status           DestinationStatus @default(DRAFT)
  metaTitle        String?
  metaDescription  String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tourPackages TourPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([status])
  @@map("destinations")
}

model TourCategory {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  name           String
  slug           String
  description    String?
  icon           String?
  imageUrl       String?
  sortOrder      Int            @default(0)
  status         CategoryStatus @default(ACTIVE)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tourPackages TourPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("tour_categories")
}

model PickupPoint {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @db.Uuid
  name              String
  address           String?
  description       String?
  latitude          Decimal?          @db.Decimal(10, 8)
  longitude         Decimal?          @db.Decimal(11, 8)
  defaultPickupTime String?
  contactName       String?
  contactPhone      String?
  status            PickupPointStatus @default(ACTIVE)

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  BookingTraveler BookingTraveler[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("pickup_points")
}

// ==========================================
// 10. TOUR PACKAGE MODELS
// ==========================================

model TourPackage {
  id               String  @id @default(uuid()) @db.Uuid
  organizationId   String  @db.Uuid
  title            String
  slug             String
  shortDescription String?
  description      String?

  destinationId String @db.Uuid
  categoryId    String @db.Uuid

  coverImageUrl String?

  durationDays   Int
  durationNights Int

  basePrice   Decimal  @db.Decimal(12, 2)
  childPrice  Decimal? @db.Decimal(12, 2)
  infantPrice Decimal? @db.Decimal(12, 2)
  currency    String   @default("BDT") @db.VarChar(3)

  status        TourPackageStatus @default(DRAFT)
  isFeatured    Boolean           @default(false)
  sortOrder     Int               @default(0)
  internalNotes String?

  publishedAt DateTime?
  createdBy   String    @db.Uuid
  updatedBy   String    @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  destination  Destination  @relation(fields: [destinationId], references: [id])
  category     TourCategory @relation(fields: [categoryId], references: [id])

  schedules          TourSchedule[]
  itinerary          TourItineraryItem[]
  inclusions         TourInclusion[]
  exclusions         TourExclusion[]
  addons             TourAddon[]
  media              TourMedia[]
  seo                TourSEO?
  bookingRules       TourBookingRule?
  cancellationPolicy TourCancellationPolicy?

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([destinationId])
  @@index([categoryId])
  @@index([status])
  @@map("tour_packages")
}

model TourSchedule {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  tourPackageId  String @db.Uuid

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  departureTime     String?
  returnTime        String?
  departureLocation String?
  returnLocation    String?

  capacity                 Int
  minimumRequiredTravelers Int?

  basePriceOverride Decimal? @db.Decimal(12, 2)
  adultPrice        Decimal? @db.Decimal(12, 2)
  childPrice        Decimal? @db.Decimal(12, 2)
  infantPrice       Decimal? @db.Decimal(12, 2)

  bookingOpenAt  DateTime?
  bookingCloseAt DateTime?

  status TourScheduleStatus @default(DRAFT)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tourPackage  TourPackage  @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)

  bookings        Booking[]
  SeatReservation SeatReservation[]

  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  TourOperation           TourOperation?
  ManifestVersion         ManifestVersion[]
  TourTransportAssignment TourTransportAssignment[]
  TourHotelAssignment     TourHotelAssignment[]
  TourGuideAssignment     TourGuideAssignment[]
  TourIncident            TourIncident[]

  @@index([organizationId, startDate])
  @@index([tourPackageId, startDate])
  @@index([organizationId, status])
  @@map("tour_schedules")
}

// ==========================================
// 11. TOUR SUB-RESOURCES
// ==========================================

model TourItineraryItem {
  id            String @id @default(uuid()) @db.Uuid
  tourPackageId String @db.Uuid

  dayNumber   Int
  sortOrder   Int
  time        String?
  title       String
  description String?

  location  String?
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  imageUrl String?

  tourPackage TourPackage @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tourPackageId])
  @@map("tour_itinerary_items")
}

model TourInclusion {
  id            String @id @default(uuid()) @db.Uuid
  tourPackageId String @db.Uuid

  title       String
  description String?
  sortOrder   Int     @default(0)

  tourPackage TourPackage @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)

  @@index([tourPackageId])
  @@map("tour_inclusions")
}

model TourExclusion {
  id            String @id @default(uuid()) @db.Uuid
  tourPackageId String @db.Uuid

  title       String
  description String?
  sortOrder   Int     @default(0)

  tourPackage TourPackage @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)

  @@index([tourPackageId])
  @@map("tour_exclusions")
}

model TourAddon {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  tourPackageId  String          @db.Uuid
  name           String
  description    String?
  price          Decimal         @db.Decimal(12, 2)
  currency       String          @default("BDT") @db.VarChar(3)
  capacity       Int?
  status         TourAddonStatus @default(ACTIVE)
  sortOrder      Int             @default(0)

  tourPackage TourPackage @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)

  BookingAddon BookingAddon[]

  @@index([organizationId])
  @@index([tourPackageId])
  @@map("tour_addons")
}

model TourMedia {
  id            String    @id @default(uuid()) @db.Uuid
  tourPackageId String    @db.Uuid
  mediaType     MediaType
  url           String
  altText       String?
  caption       String?
  sortOrder     Int       @default(0)
  isPrimary     Boolean   @default(false)

  tourPackage TourPackage @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)

  @@index([tourPackageId])
  @@map("tour_media")
}

model TourSEO {
  id            String @id @default(uuid()) @db.Uuid
  tourPackageId String @unique @db.Uuid

  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?

  ogTitle       String?
  ogDescription String?
  ogImageUrl    String?

  indexable Boolean @default(true)

  tourPackage TourPackage @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)

  @@map("tour_seo")
}

model TourBookingRule {
  id            String @id @default(uuid()) @db.Uuid
  tourPackageId String @unique @db.Uuid

  minimumTravelers        Int?
  maximumTravelers        Int?
  bookingOpenBeforeDays   Int?
  bookingCloseBeforeHours Int?

  allowChildren           Boolean @default(true)
  allowInfants            Boolean @default(true)
  allowOnlineBooking      Boolean @default(true)
  showPublicAvailability  Boolean @default(true)
  requireTravelerPhone    Boolean @default(true)
  requireEmergencyContact Boolean @default(false)

  tourPackage TourPackage @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)

  @@map("tour_booking_rules")
}

model TourCancellationPolicy {
  id            String @id @default(uuid()) @db.Uuid
  tourPackageId String @unique @db.Uuid

  name        String
  description String?

  allowCancellation        Boolean  @default(false)
  fullRefundBeforeHours    Int?
  partialRefundBeforeHours Int?
  partialRefundPercentage  Decimal? @db.Decimal(5, 2)
  nonRefundableAfterHours  Int?

  status CategoryStatus @default(ACTIVE)

  tourPackage TourPackage @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)

  @@map("tour_cancellation_policies")
}

// ==========================================
// 12. PHASE 06: CRM & BOOKING MODELS
// ==========================================

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum BookingType {
  INDIVIDUAL
  CORPORATE
  B2B
  CUSTOM
}

enum TravelerType {
  ADULT
  CHILD
  INFANT
}

enum BookingStatus {
  PENDING
  HELD
  AWAITING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
  NO_SHOW
}

enum BookingSource {
  WEBSITE
  ADMIN
  PHONE
  WHATSAPP
  FACEBOOK
  OFFICE
  REFERRAL
  OTHER
}

enum PriceItemType {
  ADULT
  CHILD
  INFANT
  ADDON
  DISCOUNT
  FEE
}

enum ReservationStatus {
  HELD
  CONFIRMED
  RELEASED
  EXPIRED
}

enum BookingNoteVisibility {
  INTERNAL
  CUSTOMER_VISIBLE
}

model Customer {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  firstName   String
  lastName    String?
  displayName String?

  email           String?
  phone           String?
  normalizedPhone String?
  whatsappPhone   String?
  countryCode     String?

  dateOfBirth DateTime? @db.Date
  gender      String?

  address  String?
  city     String?
  district String?
  country  String?

  emergencyContactName  String?
  emergencyContactPhone String?

  notes String?

  status CustomerStatus @default(ACTIVE)

  corporateClientId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy String? @db.Uuid
  updatedBy String? @db.Uuid

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  corporateClient CorporateClient? @relation(fields: [corporateClientId], references: [id])
  travelers       Traveler[]
  bookings        Booking[]

  @@index([organizationId, normalizedPhone])
  @@index([organizationId, email])
  @@index([organizationId, status])
  @@map("customers")
}

model Traveler {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  customerId     String @db.Uuid

  firstName   String
  lastName    String?
  displayName String?

  phone String?
  email String?

  dateOfBirth DateTime? @db.Date
  gender      String?

  nationality String?

  emergencyContactName  String?
  emergencyContactPhone String?

  specialRequirements String?
  notes               String?

  status CustomerStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookingTravelers BookingTraveler[]

  @@index([organizationId, customerId])
  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@map("travelers")
}

model Booking {
  id               String @id @default(uuid()) @db.Uuid
  organizationId   String @db.Uuid
  bookingReference String

  customerId     String @db.Uuid
  tourPackageId  String @db.Uuid
  tourScheduleId String @db.Uuid

  status        BookingStatus @default(PENDING)
  bookingType   BookingType   @default(INDIVIDUAL)
  bookingSource BookingSource @default(WEBSITE)
  currency      String        @default("BDT") @db.VarChar(3)

  corporateClientId String? @db.Uuid
  quotationId       String? @db.Uuid
  contractId        String? @db.Uuid

  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  addonAmount    Decimal @default(0) @db.Decimal(12, 2)
  feeAmount      Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal @default(0) @db.Decimal(12, 2)
  dueAmount      Decimal @default(0) @db.Decimal(12, 2)

  travelerCount Int
  adultCount    Int @default(0)
  childCount    Int @default(0)
  infantCount   Int @default(0)

  specialRequest String?
  internalNote   String?

  expiresAt   DateTime?
  confirmedAt DateTime?
  cancelledAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer           @relation(fields: [customerId], references: [id])
  tourPackage     TourPackage        @relation(fields: [tourPackageId], references: [id])
  tourSchedule    TourSchedule       @relation(fields: [tourScheduleId], references: [id])
  corporateClient CorporateClient?   @relation(fields: [corporateClientId], references: [id])
  quotation       Quotation?         @relation(fields: [quotationId], references: [id])
  contract        CorporateContract? @relation(fields: [contractId], references: [id])

  bookingTravelers BookingTraveler[]
  bookingAddons    BookingAddon[]
  priceItems       BookingPriceItem[]
  seatReservations SeatReservation[]
  statusHistory    BookingStatusHistory[]
  notes            BookingNote[]

  @@unique([organizationId, bookingReference])
  @@index([organizationId, customerId])
  @@index([organizationId, tourScheduleId])
  @@index([organizationId, status])
  @@index([expiresAt])
  @@map("bookings")
}

