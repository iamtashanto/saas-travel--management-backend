// ==========================================
// 1. GENERATOR & DATASOURCE
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 2. ENUMS
// ==========================================

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum PlatformAdminStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

// ==========================================
// 3. PLATFORM MODELS
// ==========================================

model PlatformAdmin {
  id           String              @id @default(uuid()) @db.Uuid
  name         String
  email        String              @unique
  passwordHash String
  status       PlatformAdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_admins")
}

// ==========================================
// 4. ORGANIZATION MODELS
// ==========================================

model Organization {
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  slug            String             @unique
  legalName       String?
  email           String?
  phone           String?
  website         String?
  logoUrl         String?
  defaultCurrency String             @default("USD") @db.VarChar(3)
  timezone        String             @default("UTC")
  countryCode     String             @default("US") @db.VarChar(2)
  status          OrganizationStatus @default(ACTIVE)

  settings OrganizationSettings?

  sequences Sequence[]
  users     User[]
  roles     Role[]
  auditLogs AuditLog[]

  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  deletedAt               DateTime?
  AuthSession             AuthSession[]
  OrganizationInvitation  OrganizationInvitation[]
  Destination             Destination[]
  TourCategory            TourCategory[]
  PickupPoint             PickupPoint[]
  TourPackage             TourPackage[]
  TourSchedule            TourSchedule[]
  Customer                Customer[]
  Traveler                Traveler[]
  Booking                 Booking[]
  SeatReservation         SeatReservation[]
  BookingStatusHistory    BookingStatusHistory[]
  BookingNote             BookingNote[]
  IdempotencyRecord       IdempotencyRecord[]
  TourOperation           TourOperation[]
  OperationalChecklist    OperationalChecklist[]
  ManifestVersion         ManifestVersion[]
  Vehicle                 Vehicle[]
  VehicleMaintenance      VehicleMaintenance[]
  Driver                  Driver[]
  TourTransportAssignment TourTransportAssignment[]
  Hotel                   Hotel[]
  HotelRoomType           HotelRoomType[]
  TourHotelAssignment     TourHotelAssignment[]
  RoomAllocation          RoomAllocation[]
  TourGuide               TourGuide[]
  TourGuideAssignment     TourGuideAssignment[]
  TourIncident            TourIncident[]
  TourOperationNote       TourOperationNote[]

  @@index([slug])
  @@index([deletedAt])
  @@map("organizations")
}

model OrganizationSettings {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @db.Uuid

  dateFormat                 String  @default("YYYY-MM-DD")
  timeFormat                 String  @default("24h")
  weekStartsOn               Int     @default(1) // 0 = Sunday, 1 = Monday
  language                   String  @default("en")
  bookingPrefix              String  @default("BKG")
  invoicePrefix              String  @default("INV")
  quotationPrefix            String  @default("QUO")
  customerPrefix             String  @default("CUS")
  defaultBookingStatus       String  @default("PENDING")
  allowOnlineBooking         Boolean @default(false)
  showPublicSeatAvailability Boolean @default(false)
  lowSeatThreshold           Int     @default(5)
  defaultCancellationPolicy  String? @db.Text

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organization_settings")
}

model Sequence {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  key          String // e.g., 'BOOKING', 'INVOICE'
  prefix       String
  currentValue Int    @default(0)
  padding      Int    @default(5)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("sequences")
}

// ==========================================
// 5. USER & RBAC MODELS
// ==========================================

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  organizationId      String     @db.Uuid
  name                String
  email               String
  phone               String?
  passwordHash        String
  avatarUrl           String?
  status              UserStatus @default(INVITED)
  passwordChangedAt   DateTime?
  emailVerifiedAt     DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  lastLoginUserAgent  String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles    UserRole[]
  authSessions AuthSession[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
  @@map("users")
}

model Role {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  slug           String
  description    String?
  isSystem       Boolean @default(false)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  userRoles    UserRole[]

  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  OrganizationInvitation OrganizationInvitation[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique // e.g. 'booking.create'
  name        String
  description String?
  module      String // e.g. 'booking', 'finance'

  roles RolePermission[]

  createdAt DateTime @default(now())

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ==========================================
// 6. AUDIT MODELS
// ==========================================

model AuditLog {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @db.Uuid // null for platform events
  userId         String? @db.Uuid

  action     String // e.g., 'CREATE', 'UPDATE', 'DELETE'
  module     String // e.g., 'tours', 'bookings'
  entityType String // e.g., 'Booking', 'Tour'
  entityId   String // UUID of the entity

  oldValues Json? // State before action
  newValues Json? // State after action
  metadata  Json? // Additional context (e.g., reason)

  ipAddress String?
  userAgent String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  // We do not strict-relate to User to preserve audit log if user is deleted,
  // or we can use SetNull. We'll leave it as a string mapping without foreign key
  // to guarantee audit logs never disappear when a user is hard-deleted.
  // Actually, SetNull on relation is fine if we make it a relation.
  // But standard practice for immutable logs is to just store the ID or rely on SetNull.
  // We'll store userId but no foreign key to avoid cascading complexities, 
  // or we can use a relation with onDelete: SetNull. Let's use standard string field for safety.

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ==========================================
// 7. AUTH & SECURITY MODELS
// ==========================================

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  organizationId   String    @db.Uuid
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?
  deviceName       String?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model OrganizationInvitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  email          String
  roleIds        String[]  @db.Uuid
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  cancelledAt    DateTime?
  invitedBy      String    @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  role      Role?    @relation(fields: [roleId], references: [id])
  roleId    String?  @db.Uuid

  @@index([organizationId])
  @@index([email])
  @@map("organization_invitations")
}

// ==========================================
// 8. TOUR ENUMS
// ==========================================

enum DestinationStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PickupPointStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TourPackageStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum TourScheduleStatus {
  DRAFT
  OPEN
  FULL
  CLOSED
  CANCELLED
  COMPLETED
}

enum TourAddonStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

// ==========================================
// 9. DESTINATION & CATEGORY MODELS
// ==========================================

model Destination {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @db.Uuid
  name             String
  slug             String
  shortDescription String?
  description      String?
  country          String?
  division         String?
  district         String?
  locationName     String?
  latitude         Decimal?          @db.Decimal(10, 8)
  longitude        Decimal?          @db.Decimal(11, 8)
  coverImageUrl    String?
  status           DestinationStatus @default(DRAFT)
  metaTitle        String?
  metaDescription  String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tourPackages TourPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([status])
  @@map("destinations")
}

model TourCategory {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  name           String
  slug           String
  description    String?
  icon           String?
  imageUrl       String?
  sortOrder      Int            @default(0)
  status         CategoryStatus @default(ACTIVE)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tourPackages TourPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("tour_categories")
}

model PickupPoint {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @db.Uuid
  name              String
  address           String?
  description       String?
  latitude          Decimal?          @db.Decimal(10, 8)
  longitude         Decimal?          @db.Decimal(11, 8)
  defaultPickupTime String?
  contactName       String?
  contactPhone      String?
  status            PickupPointStatus @default(ACTIVE)

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  BookingTraveler BookingTraveler[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("pickup_points")
}

// ==========================================
// 10. TOUR PACKAGE MODELS
// ==========================================

model TourPackage {
  id               String  @id @default(uuid()) @db.Uuid
  organizationId   String  @db.Uuid
  title            String
  slug             String
  shortDescription String?
  description      String?

  destinationId String @db.Uuid
  categoryId    String @db.Uuid

  coverImageUrl String?

  durationDays   Int
  durationNights Int

  basePrice   Decimal  @db.Decimal(12, 2)
  childPrice  Decimal? @db.Decimal(12, 2)
  infantPrice Decimal? @db.Decimal(12, 2)
  currency    String   @default("BDT") @db.VarChar(3)

  status        TourPackageStatus @default(DRAFT)
  isFeatured    Boolean           @default(false)
  sortOrder     Int               @default(0)
  internalNotes String?

  publishedAt DateTime?
  createdBy   String    @db.Uuid
  updatedBy   String    @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  destination  Destination  @relation(fields: [destinationId], references: [id])
  category     TourCategory @relation(fields: [categoryId], references: [id])

  schedules          TourSchedule[]
  itinerary          TourItineraryItem[]
  inclusions         TourInclusion[]
  exclusions         TourExclusion[]
  addons             TourAddon[]
  media              TourMedia[]
  seo                TourSEO?
  bookingRules       TourBookingRule?
  cancellationPolicy TourCancellationPolicy?

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([destinationId])
  @@index([categoryId])
  @@index([status])
  @@map("tour_packages")
}

model TourSchedule {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  tourPackageId  String @db.Uuid

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  departureTime     String?
  returnTime        String?
  departureLocation String?
  returnLocation    String?

  capacity                 Int
  minimumRequiredTravelers Int?

  basePriceOverride Decimal? @db.Decimal(12, 2)
  adultPrice        Decimal? @db.Decimal(12, 2)
  childPrice        Decimal? @db.Decimal(12, 2)
  infantPrice       Decimal? @db.Decimal(12, 2)

  bookingOpenAt  DateTime?
  bookingCloseAt DateTime?

  status TourScheduleStatus @default(DRAFT)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tourPackage  TourPackage  @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)

  bookings        Booking[]
  SeatReservation SeatReservation[]

  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  TourOperation           TourOperation?
  ManifestVersion         ManifestVersion[]
  TourTransportAssignment TourTransportAssignment[]
  TourHotelAssignment     TourHotelAssignment[]
  TourGuideAssignment     TourGuideAssignment[]
  TourIncident            TourIncident[]

  @@index([organizationId, startDate])
  @@index([tourPackageId, startDate])
  @@index([organizationId, status])
  @@map("tour_schedules")
}

// ==========================================
// 11. TOUR SUB-RESOURCES
// ==========================================

model TourItineraryItem {
  id            String @id @default(uuid()) @db.Uuid
  tourPackageId String @db.Uuid

  dayNumber   Int
  sortOrder   Int
  time        String?
  title       String
  description String?

  location  String?
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  imageUrl String?

  tourPackage TourPackage @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tourPackageId])
  @@map("tour_itinerary_items")
}

model TourInclusion {
  id            String @id @default(uuid()) @db.Uuid
  tourPackageId String @db.Uuid

  title       String
  description String?
  sortOrder   Int     @default(0)

  tourPackage TourPackage @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)

  @@index([tourPackageId])
  @@map("tour_inclusions")
}

model TourExclusion {
  id            String @id @default(uuid()) @db.Uuid
  tourPackageId String @db.Uuid

  title       String
  description String?
  sortOrder   Int     @default(0)

  tourPackage TourPackage @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)

  @@index([tourPackageId])
  @@map("tour_exclusions")
}

model TourAddon {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  tourPackageId  String          @db.Uuid
  name           String
  description    String?
  price          Decimal         @db.Decimal(12, 2)
  currency       String          @default("BDT") @db.VarChar(3)
  capacity       Int?
  status         TourAddonStatus @default(ACTIVE)
  sortOrder      Int             @default(0)

  tourPackage TourPackage @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)

  BookingAddon BookingAddon[]

  @@index([organizationId])
  @@index([tourPackageId])
  @@map("tour_addons")
}

model TourMedia {
  id            String    @id @default(uuid()) @db.Uuid
  tourPackageId String    @db.Uuid
  mediaType     MediaType
  url           String
  altText       String?
  caption       String?
  sortOrder     Int       @default(0)
  isPrimary     Boolean   @default(false)

  tourPackage TourPackage @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)

  @@index([tourPackageId])
  @@map("tour_media")
}

model TourSEO {
  id            String @id @default(uuid()) @db.Uuid
  tourPackageId String @unique @db.Uuid

  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?

  ogTitle       String?
  ogDescription String?
  ogImageUrl    String?

  indexable Boolean @default(true)

  tourPackage TourPackage @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)

  @@map("tour_seo")
}

model TourBookingRule {
  id            String @id @default(uuid()) @db.Uuid
  tourPackageId String @unique @db.Uuid

  minimumTravelers        Int?
  maximumTravelers        Int?
  bookingOpenBeforeDays   Int?
  bookingCloseBeforeHours Int?

  allowChildren           Boolean @default(true)
  allowInfants            Boolean @default(true)
  allowOnlineBooking      Boolean @default(true)
  showPublicAvailability  Boolean @default(true)
  requireTravelerPhone    Boolean @default(true)
  requireEmergencyContact Boolean @default(false)

  tourPackage TourPackage @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)

  @@map("tour_booking_rules")
}

model TourCancellationPolicy {
  id            String @id @default(uuid()) @db.Uuid
  tourPackageId String @unique @db.Uuid

  name        String
  description String?

  allowCancellation        Boolean  @default(false)
  fullRefundBeforeHours    Int?
  partialRefundBeforeHours Int?
  partialRefundPercentage  Decimal? @db.Decimal(5, 2)
  nonRefundableAfterHours  Int?

  status CategoryStatus @default(ACTIVE)

  tourPackage TourPackage @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)

  @@map("tour_cancellation_policies")
}

// ==========================================
// 12. PHASE 06: CRM & BOOKING MODELS
// ==========================================

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum TravelerType {
  ADULT
  CHILD
  INFANT
}

enum BookingStatus {
  PENDING
  HELD
  AWAITING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
  NO_SHOW
}

enum BookingSource {
  WEBSITE
  ADMIN
  PHONE
  WHATSAPP
  FACEBOOK
  OFFICE
  REFERRAL
  OTHER
}

enum PriceItemType {
  ADULT
  CHILD
  INFANT
  ADDON
  DISCOUNT
  FEE
}

enum ReservationStatus {
  HELD
  CONFIRMED
  RELEASED
  EXPIRED
}

enum BookingNoteVisibility {
  INTERNAL
  CUSTOMER_VISIBLE
}

model Customer {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  firstName   String
  lastName    String?
  displayName String?

  email           String?
  phone           String?
  normalizedPhone String?
  whatsappPhone   String?
  countryCode     String?

  dateOfBirth DateTime? @db.Date
  gender      String?

  address  String?
  city     String?
  district String?
  country  String?

  emergencyContactName  String?
  emergencyContactPhone String?

  notes String?

  status CustomerStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy String? @db.Uuid
  updatedBy String? @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  travelers    Traveler[]
  bookings     Booking[]

  @@index([organizationId, normalizedPhone])
  @@index([organizationId, email])
  @@index([organizationId, status])
  @@map("customers")
}

model Traveler {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  customerId     String @db.Uuid

  firstName   String
  lastName    String?
  displayName String?

  phone String?
  email String?

  dateOfBirth DateTime? @db.Date
  gender      String?

  nationality String?

  emergencyContactName  String?
  emergencyContactPhone String?

  specialRequirements String?
  notes               String?

  status CustomerStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookingTravelers BookingTraveler[]

  @@index([organizationId, customerId])
  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@map("travelers")
}

model Booking {
  id               String @id @default(uuid()) @db.Uuid
  organizationId   String @db.Uuid
  bookingReference String

  customerId     String @db.Uuid
  tourPackageId  String @db.Uuid
  tourScheduleId String @db.Uuid

  status        BookingStatus @default(PENDING)
  bookingSource BookingSource @default(WEBSITE)
  currency      String        @default("BDT") @db.VarChar(3)

  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  addonAmount    Decimal @default(0) @db.Decimal(12, 2)
  feeAmount      Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal @default(0) @db.Decimal(12, 2)
  dueAmount      Decimal @default(0) @db.Decimal(12, 2)

  travelerCount Int
  adultCount    Int @default(0)
  childCount    Int @default(0)
  infantCount   Int @default(0)

  specialRequest String?
  internalNote   String?

  expiresAt   DateTime?
  confirmedAt DateTime?
  cancelledAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id])
  tourPackage  TourPackage  @relation(fields: [tourPackageId], references: [id])
  tourSchedule TourSchedule @relation(fields: [tourScheduleId], references: [id])

  bookingTravelers BookingTraveler[]
  bookingAddons    BookingAddon[]
  priceItems       BookingPriceItem[]
  seatReservations SeatReservation[]
  statusHistory    BookingStatusHistory[]
  notes            BookingNote[]

  @@unique([organizationId, bookingReference])
  @@index([organizationId, customerId])
  @@index([organizationId, tourScheduleId])
  @@index([organizationId, status])
  @@index([expiresAt])
  @@map("bookings")
}

model BookingTraveler {
  id         String @id @default(uuid()) @db.Uuid
  bookingId  String @db.Uuid
  travelerId String @db.Uuid

  travelerType TravelerType

  // Snapshots
  firstName String
  lastName  String?
  phone     String?
  email     String?

  unitPrice Decimal @default(0) @db.Decimal(12, 2)

  pickupPointId String? @db.Uuid

  specialRequirement String?

  // Operational Status
  operationalStatus TravelerOperationalStatus @default(BOOKED)
  checkedInAt       DateTime?
  checkedInBy       String?                   @db.Uuid
  boardedAt         DateTime?
  boardedBy         String?                   @db.Uuid

  createdAt DateTime @default(now())

  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  traveler    Traveler     @relation(fields: [travelerId], references: [id])
  pickupPoint PickupPoint? @relation(fields: [pickupPointId], references: [id])

  @@index([bookingId])
  @@map("booking_travelers")
}

model BookingPriceItem {
  id        String @id @default(uuid()) @db.Uuid
  bookingId String @db.Uuid

  type        PriceItemType
  description String
  quantity    Int
  unitPrice   Decimal       @db.Decimal(12, 2)
  totalPrice  Decimal       @db.Decimal(12, 2)
  currency    String        @default("BDT") @db.VarChar(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_price_items")
}

model BookingAddon {
  id          String @id @default(uuid()) @db.Uuid
  bookingId   String @db.Uuid
  tourAddonId String @db.Uuid

  nameSnapshot String
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)
  totalPrice   Decimal @db.Decimal(12, 2)
  currency     String  @default("BDT") @db.VarChar(3)

  booking Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addon   TourAddon @relation(fields: [tourAddonId], references: [id])

  @@index([bookingId])
  @@map("booking_addons")
}

model SeatReservation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  bookingId      String @db.Uuid
  tourScheduleId String @db.Uuid

  quantity Int
  status   ReservationStatus

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tourSchedule TourSchedule @relation(fields: [tourScheduleId], references: [id], onDelete: Cascade)

  @@index([organizationId, tourScheduleId, status])
  @@index([expiresAt])
  @@map("seat_reservations")
}

model BookingStatusHistory {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  bookingId      String @db.Uuid

  fromStatus BookingStatus?
  toStatus   BookingStatus
  reason     String?
  metadata   Json?

  changedBy String? @db.Uuid

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

model BookingNote {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  bookingId      String @db.Uuid

  content    String
  visibility BookingNoteVisibility @default(INTERNAL)

  authorId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_notes")
}

model IdempotencyRecord {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  key         String
  requestHash String?
  status      String
  response    Json?

  expiresAt DateTime

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// ==========================================
// 8. PHASE 07: TOUR OPERATIONS & RESOURCES
// ==========================================

enum TourOperationStatus {
  DRAFT
  PREPARING
  READY
  DEPARTED
  IN_PROGRESS
  RETURNING
  COMPLETED
  CANCELLED
}

enum TravelerOperationalStatus {
  BOOKED
  CONFIRMED
  CHECKED_IN
  NO_SHOW
  BOARDED
  COMPLETED
  CANCELLED
}

enum ChecklistCategory {
  TRANSPORT
  TRAVELERS
  HOTEL
  GUIDE
  FINANCE
  DOCUMENTS
  SAFETY
  GENERAL
}

enum VehicleType {
  BUS
  MICROBUS
  CAR
  BOAT
  LAUNCH
  OTHER
}

enum ResourceStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  ON_LEAVE
  INACTIVE
}

enum GuideRole {
  LEAD_GUIDE
  ASSISTANT_GUIDE
  LOCAL_GUIDE
}

enum IncidentType {
  MEDICAL
  TRANSPORT
  TRAVELER
  HOTEL
  WEATHER
  SAFETY
  SECURITY
  FINANCE
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum NoteVisibility {
  INTERNAL
  STAFF
  MANAGER_ONLY
}

model TourOperation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  tourScheduleId String @unique @db.Uuid

  operationCode String              @unique
  status        TourOperationStatus @default(DRAFT)

  plannedDepartureAt DateTime?
  actualDepartureAt  DateTime?
  plannedReturnAt    DateTime?
  actualReturnAt     DateTime?

  departureLocation String?
  returnLocation    String?

  totalTravelers Int @default(0)

  notes         String? @db.Text
  internalNotes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tourSchedule TourSchedule @relation(fields: [tourScheduleId], references: [id], onDelete: Cascade)

  checklists     OperationalChecklist[]
  incidents      TourIncident[]
  operationNotes TourOperationNote[]

  @@index([organizationId, status])
  @@map("tour_operations")
}

model OperationalChecklist {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  tourOperationId String            @db.Uuid
  category        ChecklistCategory

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tourOperation TourOperation              @relation(fields: [tourOperationId], references: [id], onDelete: Cascade)
  items         OperationalChecklistItem[]

  @@index([tourOperationId])
  @@map("operational_checklists")
}

model OperationalChecklistItem {
  id          String @id @default(uuid()) @db.Uuid
  checklistId String @db.Uuid

  title       String
  description String? @db.Text

  isRequired  Boolean @default(true)
  isCompleted Boolean @default(false)

  completedAt DateTime?
  completedBy String?   @db.Uuid

  sortOrder Int @default(0)

  checklist OperationalChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@map("operational_checklist_items")
}

model ManifestVersion {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  tourScheduleId String @db.Uuid

  version Int
  status  String @default("DRAFT") // DRAFT, FINAL

  generatedAt DateTime @default(now())
  generatedBy String?  @db.Uuid

  dataSnapshot Json? // Stores the actual manifest data

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tourSchedule TourSchedule @relation(fields: [tourScheduleId], references: [id], onDelete: Cascade)

  @@unique([tourScheduleId, version])
  @@map("manifest_versions")
}

model Vehicle {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  name               String
  registrationNumber String
  type               VehicleType

  capacity Int
  status   ResourceStatus @default(AVAILABLE)

  brand           String?
  model           String?
  color           String?
  manufactureYear Int?
  currentMileage  Int?

  notes    String? @db.Text
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  TourTransportAssignment[]
  maintenance  VehicleMaintenance[]

  @@unique([organizationId, registrationNumber])
  @@map("vehicles")
}

model VehicleMaintenance {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  vehicleId      String @db.Uuid

  maintenanceType     String
  description         String?   @db.Text
  cost                Decimal   @default(0) @db.Decimal(12, 2)
  date                DateTime
  nextMaintenanceDate DateTime?
  odometer            Int?
  vendor              String?
  notes               String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_maintenance")
}

model Driver {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  name           String
  phone          String
  alternatePhone String?

  licenseNumber     String
  licenseType       String?
  licenseExpiryDate DateTime

  experienceYears  Int?
  address          String? @db.Text
  emergencyContact String?

  status   ResourceStatus @default(AVAILABLE)
  notes    String?        @db.Text
  isActive Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  TourTransportAssignment[]

  @@unique([organizationId, licenseNumber])
  @@map("drivers")
}

model TourTransportAssignment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  tourScheduleId String @db.Uuid

  vehicleId String  @db.Uuid
  driverId  String? @db.Uuid
  helperId  String? @db.Uuid

  departureAt DateTime?
  returnAt    DateTime?

  pickupNotes  String? @db.Text
  seatCapacity Int

  status String  @default("ASSIGNED")
  notes  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tourSchedule TourSchedule @relation(fields: [tourScheduleId], references: [id], onDelete: Cascade)
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id])
  driver       Driver?      @relation(fields: [driverId], references: [id])

  @@index([tourScheduleId])
  @@index([vehicleId])
  @@index([driverId])
  @@map("tour_transport_assignments")
}

model Hotel {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  name    String
  code    String?
  address String? @db.Text
  city    String?
  country String?

  phone         String?
  email         String?
  contactPerson String?

  rating  Int?
  website String?
  notes   String? @db.Text

  status   ResourceStatus @default(AVAILABLE)
  isActive Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roomTypes    HotelRoomType[]
  assignments  TourHotelAssignment[]

  @@index([organizationId, city])
  @@map("hotels")
}

model HotelRoomType {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  hotelId        String @db.Uuid

  name           String // Single, Double, etc.
  capacity       Int
  totalRooms     Int    @default(0)
  availableRooms Int    @default(0)

  basePrice   Decimal @default(0) @db.Decimal(12, 2)
  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hotel        Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  allocations  RoomAllocation[]

  @@map("hotel_room_types")
}

model TourHotelAssignment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  tourScheduleId String @db.Uuid
  hotelId        String @db.Uuid

  checkIn  DateTime?
  checkOut DateTime?
  notes    String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tourSchedule TourSchedule     @relation(fields: [tourScheduleId], references: [id], onDelete: Cascade)
  hotel        Hotel            @relation(fields: [hotelId], references: [id])
  allocations  RoomAllocation[]

  @@index([tourScheduleId])
  @@map("tour_hotel_assignments")
}

model RoomAllocation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  assignmentId   String @db.Uuid
  roomTypeId     String @db.Uuid

  roomId         String? // specific physical room identifier, if known
  capacity       Int
  allocatedCount Int     @default(0)

  status String @default("ALLOCATED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignment   TourHotelAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  roomType     HotelRoomType       @relation(fields: [roomTypeId], references: [id])

  @@index([assignmentId])
  @@map("room_allocations")
}

model TourGuide {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  name  String
  phone String
  email String?

  experienceYears Int?
  languages       String[] // E.g., ['English', 'Bengali']
  specialization  String?

  emergencyContact String?
  photoUrl         String?

  status   ResourceStatus @default(AVAILABLE)
  notes    String?        @db.Text
  isActive Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  TourGuideAssignment[]

  @@map("tour_guides")
}

model TourGuideAssignment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  tourScheduleId String @db.Uuid
  guideId        String @db.Uuid

  role GuideRole @default(LOCAL_GUIDE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tourSchedule TourSchedule @relation(fields: [tourScheduleId], references: [id], onDelete: Cascade)
  guide        TourGuide    @relation(fields: [guideId], references: [id])

  @@index([tourScheduleId])
  @@index([guideId])
  @@map("tour_guide_assignments")
}

model TourIncident {
  id              String  @id @default(uuid()) @db.Uuid
  organizationId  String  @db.Uuid
  tourScheduleId  String  @db.Uuid
  tourOperationId String? @db.Uuid

  type     IncidentType
  severity IncidentSeverity
  status   IncidentStatus   @default(OPEN)

  title       String
  description String @db.Text

  reportedAt DateTime @default(now())
  reportedBy String?  @db.Uuid

  resolvedAt DateTime?
  resolvedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tourSchedule  TourSchedule   @relation(fields: [tourScheduleId], references: [id], onDelete: Cascade)
  tourOperation TourOperation? @relation(fields: [tourOperationId], references: [id])

  @@index([organizationId, status])
  @@index([tourScheduleId])
  @@index([tourOperationId])
  @@map("tour_incidents")
}

model TourOperationNote {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @db.Uuid
  tourOperationId String @db.Uuid

  title      String?
  content    String         @db.Text
  visibility NoteVisibility @default(INTERNAL)

  authorId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tourOperation TourOperation @relation(fields: [tourOperationId], references: [id], onDelete: Cascade)

  @@index([tourOperationId])
  @@map("tour_operation_notes")
}
