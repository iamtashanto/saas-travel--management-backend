model Booking {
  id               String @id @default(uuid()) @db.Uuid
  organizationId   String @db.Uuid
  bookingReference String

  customerId     String @db.Uuid
  tourPackageId  String @db.Uuid
  tourScheduleId String @db.Uuid

  status        BookingStatus @default(PENDING)
  bookingType   BookingType   @default(INDIVIDUAL)
  bookingSource BookingSource @default(WEBSITE)
  currency      String        @default("BDT") @db.VarChar(3)

  corporateClientId String? @db.Uuid
  quotationId       String? @db.Uuid
  contractId        String? @db.Uuid

  campaignId  String? @db.Uuid
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  addonAmount    Decimal @default(0) @db.Decimal(12, 2)
  feeAmount      Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal @default(0) @db.Decimal(12, 2)
  dueAmount      Decimal @default(0) @db.Decimal(12, 2)

  travelerCount Int
  adultCount    Int @default(0)
  childCount    Int @default(0)
  infantCount   Int @default(0)

  specialRequest String?
  internalNote   String?

  expiresAt   DateTime?
  confirmedAt DateTime?
  cancelledAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer           @relation(fields: [customerId], references: [id])
  tourPackage     TourPackage        @relation(fields: [tourPackageId], references: [id])
  tourSchedule    TourSchedule       @relation(fields: [tourScheduleId], references: [id])
  corporateClient CorporateClient?   @relation(fields: [corporateClientId], references: [id])
  quotation       Quotation?         @relation(fields: [quotationId], references: [id])
  contract        CorporateContract? @relation(fields: [contractId], references: [id])

  bookingTravelers BookingTraveler[]
  bookingAddons    BookingAddon[]
  priceItems       BookingPriceItem[]
  seatReservations SeatReservation[]
  statusHistory    BookingStatusHistory[]
  notes            BookingNote[]

  couponRedemptions CouponRedemption[]
  referrals         Referral[]
  reviews           Review[]
  campaign          MarketingCampaign? @relation(fields: [campaignId], references: [id])

  @@unique([organizationId, bookingReference])
  @@index([organizationId, customerId])
  @@index([organizationId, tourScheduleId])
  @@index([organizationId, status])
  @@index([expiresAt])
  @@map("bookings")
}

model BookingTraveler {
  id         String @id @default(uuid()) @db.Uuid
  bookingId  String @db.Uuid
  travelerId String @db.Uuid

